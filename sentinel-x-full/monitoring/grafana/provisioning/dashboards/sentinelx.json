{
  "annotations": { "list": [] },
  "editable": true,
  "title": "SentinelX -- SupportDesk Observability",
  "uid": "sentinelx-main",
  "tags": ["sentinelx", "supportdesk"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" },
        "hide": 0
      }
    ]
  },
  "__comment": "NOMS DE METRIQUES A ALIGNER AVEC CONTRACT.md. Ici on suppose les noms conventionnels prom-client ci-dessous. Si A choisit d'autres noms, les reporter dans les 'expr'.",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requêtes HTTP par seconde (par route)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (route) (rate(http_requests_total[1m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Taux d'erreurs HTTP (4xx / 5xx) par seconde",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum by (status_code) (rate(http_requests_total{status_code=~\"4..|5..\"}[1m]))",
          "legendFormat": "{{status_code}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Échecs d'authentification (5 min)",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 30 }
            ]
          }
        }
      },
      "targets": [
        { "expr": "sum(increase(auth_failures_total[5m]))", "legendFormat": "auth_failures" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Requêtes totales (5 min)",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum(increase(http_requests_total[5m]))", "legendFormat": "requests" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Latence HTTP p95 (secondes)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{route}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Accès refusés / erreurs serveur par seconde",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status_code=\"403\"}[1m]))",
          "legendFormat": "403 access_denied"
        },
        {
          "expr": "sum(rate(http_requests_total{status_code=\"500\"}[1m]))",
          "legendFormat": "500 server_error"
        }
      ]
    }
  ]
}
