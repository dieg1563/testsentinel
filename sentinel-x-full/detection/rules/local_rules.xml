<!--
  local_rules.xml : règles de détection SentinelX

  Champs disponibles (décodeur JSON natif) sous le préfixe data.* :
    data.event_type, data.source_ip, data.user, data.endpoint,
    data.method, data.status_code, data.query, data.body

  Monté dans : /var/ossec/etc/rules/local_rules.xml
  Plage d'ID locale recommandée par Wazuh : 100000+

  Niveaux (severity) alignés sur les Attack Plans :
    - scan / énumération ...... 8
    - brute force ............. 10
    - accès admin refusé ...... 10-12
    - injection SQL / XSS ..... 12
-->

<group name="supportdesk,sentinelx,">

  <!-- Règle mère : tout événement applicatif SupportDesk -->
  <rule id="100000" level="0">
    <decoded_as>json</decoded_as>
    <field name="endpoint">\.+</field>
    <description>SupportDesk : événement applicatif</description>
  </rule>

  <!-- ===================== AUTHENTIFICATION ===================== -->

  <!-- Un échec d'authentification isolé -->
  <rule id="100100" level="5">
    <if_sid>100000</if_sid>
    <field name="event_type">^auth_failure$</field>
    <description>SupportDesk : échec d'authentification pour $(data.user) depuis $(data.source_ip)</description>
    <group>authentication_failed,</group>
  </rule>

  <!-- Brute force : plusieurs échecs depuis la même IP (Attack Plan 01, T1110) -->
  <rule id="100101" level="10" frequency="6" timeframe="60">
    <if_matched_sid>100100</if_matched_sid>
    <same_field>source_ip</same_field>
    <description>SupportDesk : brute force d'authentification depuis $(data.source_ip) (>=6 échecs/60s)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,brute_force,</group>
  </rule>

  <!-- Login réussi après une rafale d'échecs : brute force potentiellement abouti -->
  <rule id="100102" level="12">
    <if_sid>100000</if_sid>
    <field name="event_type">^auth_success$</field>
    <if_matched_sid>100101</if_matched_sid>
    <same_field>source_ip</same_field>
    <description>SupportDesk : login réussi depuis $(data.source_ip) après brute force : compromission probable</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_success,brute_force,</group>
  </rule>

  <!-- ===================== INJECTION SQL (Attack Plan 02, T1190) ===================== -->

  <rule id="100200" level="12">
    <if_sid>100000</if_sid>
    <field name="query" type="pcre2">(?i)(\bunion\b.+\bselect\b|'\s*or\s*'?1'?\s*=\s*'?1|--\s|;--|\bselect\b.+\bfrom\b)</field>
    <description>SupportDesk : tentative d'injection SQL dans la query depuis $(data.source_ip) : $(data.endpoint)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>sql_injection,web_attack,</group>
  </rule>

  <rule id="100201" level="12">
    <if_sid>100000</if_sid>
    <field name="body" type="pcre2">(?i)(\bunion\b.+\bselect\b|'\s*or\s*'?1'?\s*=\s*'?1|--\s|;--)</field>
    <description>SupportDesk : tentative d'injection SQL dans le body depuis $(data.source_ip) : $(data.endpoint)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>sql_injection,web_attack,</group>
  </rule>

  <!-- ===================== XSS (bonus web attack) ===================== -->

  <rule id="100210" level="10">
    <if_sid>100000</if_sid>
    <field name="query" type="pcre2">(?i)(&lt;script|%3Cscript|onerror\s*=|javascript:)</field>
    <description>SupportDesk : tentative XSS depuis $(data.source_ip) : $(data.endpoint)</description>
    <mitre>
      <id>T1059.007</id>
    </mitre>
    <group>xss,web_attack,</group>
  </rule>

  <!-- ===================== SCAN / ENUMERATION (Attack Plan 03, T1595) ===================== -->

  <!-- Un 404 isolé : bruit, niveau bas -->
  <rule id="100300" level="2">
    <if_sid>100000</if_sid>
    <field name="event_type">^not_found$</field>
    <description>SupportDesk : ressource introuvable ($(data.endpoint)) depuis $(data.source_ip)</description>
  </rule>

  <!-- Beaucoup de 404 depuis la même IP : scan / directory enumeration -->
  <rule id="100301" level="8" frequency="15" timeframe="30">
    <if_matched_sid>100300</if_matched_sid>
    <same_field>source_ip</same_field>
    <description>SupportDesk : énumération/scan d'endpoints depuis $(data.source_ip) (>=15 x 404/30s)</description>
    <mitre>
      <id>T1595</id>
    </mitre>
    <group>recon,scan,</group>
  </rule>

  <!-- ===================== ACCES REFUSE / ADMIN (T1548) ===================== -->

  <rule id="100400" level="6">
    <if_sid>100000</if_sid>
    <field name="event_type">^access_denied$</field>
    <description>SupportDesk : accès refusé sur $(data.endpoint) pour $(data.user) depuis $(data.source_ip)</description>
    <group>access_control,</group>
  </rule>

  <!-- Accès refusé répété sur /admin : tentative d'élévation / forced browsing -->
  <rule id="100401" level="10" frequency="4" timeframe="60">
    <if_matched_sid>100400</if_matched_sid>
    <same_field>source_ip</same_field>
    <field name="endpoint" type="pcre2">^/admin</field>
    <description>SupportDesk : accès admin refusé répété depuis $(data.source_ip) : forced browsing</description>
    <mitre>
      <id>T1548</id>
    </mitre>
    <group>access_control,privilege_escalation,</group>
  </rule>

  <!-- ===================== ERREURS SERVEUR ===================== -->

  <rule id="100500" level="7">
    <if_sid>100000</if_sid>
    <field name="event_type">^server_error$</field>
    <description>SupportDesk : erreur serveur 500 sur $(data.endpoint) depuis $(data.source_ip)</description>
    <group>system_error,</group>
  </rule>

</group>
